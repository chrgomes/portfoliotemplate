{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": {
    "analytics": false
  },
  "projects": {
    "portfolio": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "pf",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/portfolio",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "outputMode": "static",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "public" },
              { "glob": ".htaccess", "input": "hosting/godaddy", "output": "/" },
              { "glob": "contact.php", "input": "hosting/godaddy", "output": "/" }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap-reboot.min.css",
              "node_modules/bootstrap/dist/css/bootstrap-utilities.min.css",
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "350kB", "maximumError": "600kB" },
                { "type": "anyComponentStyle", "maximumWarning": "4kB", "maximumError": "8kB" }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "portfolio:build:production" },
            "development": { "buildTarget": "portfolio:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
